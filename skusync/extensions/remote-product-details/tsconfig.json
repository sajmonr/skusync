{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "target": "ES2020",
    "checkJs": true,
    "allowJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  // Without an explicit include, tsc also walks dist/ and reports thousands of errors from the
  // minified Preact bundle the Shopify CLI writes there. ../../shared holds the cross-project URL
  // construction this extension imports.
  "include": ["src/**/*", "*.d.ts", "../../shared/**/*"]
}
