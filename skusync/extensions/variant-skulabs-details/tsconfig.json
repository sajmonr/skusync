{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "target": "ES2020",
    "checkJs": true,
    "allowJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  // Without an explicit include, tsc also walks dist/ and reports thousands of errors from the
  // minified Preact bundle the Shopify CLI writes there. ../../shared holds the view components and
  // the cross-project URL construction this extension imports; including it here is what checks that
  // shared code against this extension's target API.
  "include": ["src/**/*", "*.d.ts", "../../shared/**/*"]
}
