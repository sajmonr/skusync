# Copy to .env and adjust. compose.yaml has safe defaults for every value below, so the stack
# boots with no .env at all — you only need this to change the PostgreSQL credentials.

# --- PostgreSQL (compose `postgres` service, published on host port 5433) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=skusync

# Shopify / SkuLabs / AWS credentials are NOT set here — they are read from each project's .NET
# user secrets, mounted read-only into the web-api and app-server containers (see the `volumes:`
# entries in compose.yaml). Manage them with `dotnet user-secrets` in dotnet/src/Web.Api and
# dotnet/src/AppServer as usual.
