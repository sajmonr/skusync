# Copy to .env and adjust. Both compose files have safe defaults for every value below, so the
# stack boots with no .env at all — you only need this to change the PostgreSQL / RabbitMQ
# credentials.

# --- PostgreSQL ---
# Dev compose (compose.yaml) publishes on host port 5434; compose.e2e.yaml on 5433.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=skusync

# --- RabbitMQ (dev compose `rabbitmq` service: AMQP on host 5674, management UI on 15674) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Shopify / SkuLabs / AWS credentials are NOT set here — they are read from each project's .NET
# user secrets, mounted read-only into the web-api and app-server containers (see the `volumes:`
# entries in compose.e2e.yaml). Manage them with `dotnet user-secrets` in dotnet/src/Web.Api and
# dotnet/src/AppServer as usual.
