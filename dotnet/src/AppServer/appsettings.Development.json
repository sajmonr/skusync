{
  "ConnectionStrings": {
    "SkuSync": "Host=localhost;Port=5434;Database=skusync;Username=postgres;Password=password",
    "RabbitMq": "amqp://guest:guest@localhost:5674"
  },
  "DatabaseMigration": {
    "LockTimeoutSeconds": 120
  },
  "FeatureManagement": {
    "ShopifyWriteBack": true,
    "ShopifySyncEnabled": true,
    "SkulabsSyncEnabled": false,
    "SkulabsWriteBack": false
  },
  "Skulabs": {
    "Api": {
      "BaseUrl": "https://api.skulabs.com",
      "ApiKey": ""
    },
    "Admin": {
      "BaseUrl": "https://app.skulabs.com",
      "Username": "",
      "Password": ""
    }
  },
  "Shopify": {
    "ShopUrl": "https://unused-desktop.myshopify.com",
    "ApiKey": ""
  },
  "Aws": {
    "Auth": {
      "AccessKey": "",
      "SecretKey": "",
      "Region": "us-east-1"
    },
    "Sqs": {
      "QueueUrl": "https://sqs.us-east-1.amazonaws.com/776952074202/dev-shopify-shop-events"
    }
  },
  "ScheduledJobs": {
    "ShopifyProductSync": {
      "Cron": "0 0 * * *",
      "Enabled": true
    },
    "SkuAndBarcodeSync": {
      "Cron": "15 0 * * *",
      "Enabled": true
    },
    "SkulabsTitleSync": {
      "Cron": "30 0 * * *",
      "Enabled": true
    },
    "SkulabsItemSync": {
      "Cron": "*/10 * * * *",
      "Enabled": true
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
