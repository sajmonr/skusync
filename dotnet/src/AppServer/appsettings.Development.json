{
  "ConnectionStrings": {
    "SkuSync": "Host=localhost;Port=5434;Database=skusync;Username=postgres;Password=password"
  },
  "DatabaseMigration": {
    "LockTimeoutSeconds": 120
  },
  "FeatureManagement": {
    "ShopifyWriteBack": true,
    "ShopifySyncEnabled": true,
    "SkulabsSyncEnabled": true,
    "SkulabsWriteBack": true,
    "ShopifyAutoDispatch": true,
    "SkulabsAutoDispatch": true
  },
  "Skulabs": {
    "Api": {
      "BaseUrl": "http://localhost:5675",
      "ApiKey": "skusync-local-mock-key",
      "WarehouseId": "69912a8923657b958806a418"
    },
    "Admin": {
      "BaseUrl": "https://app.skulabs.com",
      "Username": "",
      "Password": ""
    }
  },
  "Shopify": {
    "ShopUrl": "https://unused-desktop.myshopify.com",
    "ApiKey": ""
  },
  "Aws": {
    "Auth": {
      "AccessKey": "",
      "SecretKey": "",
      "Region": "us-east-1"
    },
    "Sqs": {
      "QueueUrl": "https://sqs.us-east-1.amazonaws.com/776952074202/dev-shopify-shop-events"
    }
  },
  "SyncDrainLoop": {
    "Enabled": true,
    "TickSeconds": 10,
    "SkulabsMinimumPushIntervalSeconds": 45
  },
  "ScheduledJobs": {
    "ShopifyProductSync": {
      "Cron": "0 0 * * *",
      "Enabled": true
    },
    "SkulabsItemSync": {
      "Cron": "*/10 * * * *",
      "Enabled": true
    },
    "FullReconcile": {
      "Cron": "15 0 * * *",
      "Enabled": true
    },
    "ShopifyDispatch": {
      "Cron": "*/10 * * * *",
      "Enabled": true
    },
    "SkulabsDispatch": {
      "Cron": "*/10 * * * *",
      "Enabled": true
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "ServerUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "SkuSync.AppServer"
    }
  }
}
