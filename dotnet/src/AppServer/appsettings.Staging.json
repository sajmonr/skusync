{
  "ConnectionStrings": {
    "SkuSync": ""
  },
  "DatabaseMigration": {
    "LockTimeoutSeconds": 120
  },
  "Skulabs": {
    "Api": {
      "BaseUrl": "https://api.skulabs.com",
      "ApiKey": ""
    },
    "Admin": {
      "BaseUrl": "https://app.skulabs.com",
      "Username": "",
      "Password": ""
    }
  },
  "Shopify": {
    "ShopUrl": "https://ivyandlavyboutique.myshopify.com",
    "ApiKey": ""
  },
  "Aws": {
    "Auth": {
      "AccessKey": "",
      "SecretKey": "",
      "Region": "us-east-1"
    },
    "Sqs": {
      "QueueUrl": "https://sqs.us-east-1.amazonaws.com/776952074202/staging-ivyandlavy-shop-events"
    }
  },
  "FeatureManagement": {
    "ShopifyWriteBack": false,
    "ShopifySyncEnabled": true,
    "SkulabsSyncEnabled": true,
    "SkulabsWriteBack": false,
    "ShopifyAutoDispatch": true,
    "SkulabsAutoDispatch": true
  },
  "ScheduledJobs": {
    "ShopifyProductSync": {
      "Cron": "0 0 * * *",
      "Enabled": true
    },
    "SkulabsItemSync": {
      "Cron": "*/10 * * * *",
      "Enabled": true
    },
    "FullReconcile": {
      "Cron": "15 0 * * *",
      "Enabled": true
    },
    "ShopifyDispatch": {
      "Cron": "*/2 * * * *",
      "Enabled": true
    },
    "SkulabsDispatch": {
      "Cron": "*/5 * * * *",
      "Enabled": true
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}
