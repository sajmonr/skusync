{
  "ConnectionStrings": {
    "SkuSync": "",
    "RabbitMq": ""
  },
  "DatabaseMigration": {
    "LockTimeoutSeconds": 120
  },
  "Skulabs": {
    "Api": {
      "BaseUrl": "https://api.skulabs.com",
      "ApiKey": ""
    },
    "Admin": {
      "BaseUrl": "https://app.skulabs.com",
      "Username": "",
      "Password": ""
    }
  },
  "Shopify": {
    "ShopUrl": "https://ivyandlavyboutique.myshopify.com",
    "ApiKey": ""
  },
  "Aws": {
    "Auth": {
      "AccessKey": "",
      "SecretKey": "",
      "Region": "us-east-1"
    },
    "Sqs": {
      "QueueUrl": "https://sqs.us-east-1.amazonaws.com/776952074202/shopify-shop-events"
    }
  },
  "FeatureManagement": {
    "ShopifyWriteBack": true,
    "ShopifySyncEnabled": true,
    "SkulabsSyncEnabled": true,
    "SkulabsWriteBack": false
  },
  "SkuGenerator": {
    "Prefix": "BW",
    "MaxLength": 25,
    "Delimiter": "-"
  },
  "ScheduledJobs": {
    "ShopifyProductSync": {
      "Cron": "0 0 * * *",
      "Enabled": true
    },
    "SkuAndBarcodeSync": {
      "Cron": "15 0 * * *",
      "Enabled": true
    },
    "SkulabsTitleSync": {
      "Cron": "30 0 * * *",
      "Enabled": true
    },
    "SkulabsItemSync": {
      "Cron": "*/10 * * * *",
      "Enabled": true
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "SkuSync.AppServer"
    }
  }
}
