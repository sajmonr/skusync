{
  "ConnectionStrings": {
    "SkuSync": ""
  },
  "DatabaseMigration": {
    "LockTimeoutSeconds": 120
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Warning"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
