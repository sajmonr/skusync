{
  "DashboardAuthentication": {
    "BypassOnDevelopment": true,
    "SessionDurationHours": 12
  },
  "ConnectionStrings": {
    "SkuSync": "Host=localhost;Port=5434;Database=skusync;Username=postgres;Password=password",
    "RabbitMq": "amqp://guest:guest@localhost:5674"
  },
  "DatabaseMigration": {
    "LockTimeoutSeconds": 120
  },
  "Cors": {
    "AllowedOrigins": [
      "https://skulabs.darkflux.app",
      "http://localhost:4200",
      "http://127.0.0.1:4200"
    ]
  },
  "FeatureManagement": {
    "ShopifyWriteBack": true,
    "ShopifySyncEnabled": true,
    "SkulabsSyncEnabled": false,
    "SkulabsWriteBack": false
  },
  "Skulabs": {
    "Api": {
      "BaseUrl": "https://api.skulabs.com",
      "ApiKey": ""
    },
    "Admin": {
      "BaseUrl": "https://app.skulabs.com",
      "Username": "",
      "Password": ""
    }
  },
  "Shopify": {
    "ShopUrl": "https://unused-desktop.myshopify.com",
    "ApiKey": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "SkuSync.Web.Api"
    }
  }
}
